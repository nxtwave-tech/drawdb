    "nanoid": "^5.1.5",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hotkeys-hook": "^4.4.1",
    "react-scripts": "5.0.1",
    "react-svg-unique-id": "1.3.3",
    "url": "^0.11.1",
    "usehooks-ts": "^3.1.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.0.0",
    "@types/react": "^17.0.65",
    "@types/react-dom": "^17.0.20",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.55.0",
